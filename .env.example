# Copy this file to .env.local for local overrides. .env.local is git-ignored.
#
# NEXT_PUBLIC_SITE_URL (optional, recommended once you have a domain)
#   The public address of the site, used for canonical links, the sitemap,
#   robots.txt, JSON-LD and share-image URLs. No trailing slash.
#   If unset, Vercel's production URL is used automatically
#   (VERCEL_PROJECT_PRODUCTION_URL), and http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
